# Copy to .env and fill in real values for local dev.
# See Docs/MIGRATION_PLAN.md §3/§6 for what each of these backs.

APP_ENV=local
DEBUG=true
APP_NAME=ap-v3

# Postgres (async, asyncpg driver)
DATABASE_URL=postgresql+asyncpg://ap:ap@localhost:5432/ap_v3

# Redis / Celery (Celery + Redis + Flower — MIGRATION_PLAN.md §7.7)
REDIS_URL=redis://localhost:6379/0
# Leave unset to default to REDIS_URL for both broker and result backend.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Sentry (blank = disabled locally)
SENTRY_DSN=

# Auth — Sanctum-compatible Personal Access Tokens, not JWT (MIGRATION_PLAN.md §6)
TOKEN_HASH_SECRET=change-me

# CryptoJS-AES compatibility — mirrors AP-V2's APP_PASS_PHRASE (MIGRATION_PLAN.md §7.3)
APP_PASS_PHRASE=change-me
