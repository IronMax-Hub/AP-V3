# Copy this file to parity_check.env (already .gitignored — verify before committing anything
# named like it) and fill in real UAT values. Never commit real tokens.
#
# Run with: python -m scripts.api_parity_check.cli --env-file scripts/api_parity_check/parity_check.env --all

# --- Lawsikho-Assignment-Portal-API (AP-V2), UAT ---
