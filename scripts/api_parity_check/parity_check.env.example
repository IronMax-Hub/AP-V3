# auth:sanctum admin token (Bearer). Mint one via POST /v1/login on UAT with a test admin account.
LEGACY_ADMIN_TOKEN=
# auth:student token (Bearer), if/when an endpoint needs it.
LEGACY_STUDENT_TOKEN=

# --- AP-V3, UAT ---
AP_V3_BASE_URL=https://uat-api-v3.example.com
